{
  "name": "ai-simultaneous-translation",
  "version": "2.0.0",
  "description": "Qwen 3.8 实时同传 · 说话人字幕与本地记录",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "serve": "node electron/service.js",
    "test": "node --test tests/*.test.cjs",
    "probe": "node scripts/probe-realtime.cjs",
    "verify:overlay": "electron scripts/verify-overlay.cjs",
    "verify:loopback": "electron scripts/verify-loopback.cjs",
    "verify:capture": "electron scripts/verify-capture.cjs",
    "verify:live": "electron scripts/verify-electron.cjs",
    "verify:audio-routing": "electron scripts/verify-audio-routing.cjs",
    "verify:desktop": "electron scripts/verify-desktop.cjs",
    "driver:restore": "pwsh -NoProfile -File native/virtual-microphone/restore-toolchain.ps1",
    "driver:build": "pwsh -NoProfile -File native/virtual-microphone/build.ps1",
    "driver:test": "pwsh -NoProfile -File native/virtual-microphone/build.ps1 -TestOnly",
    "driver:check": "pwsh -NoProfile -File native/virtual-microphone/install.ps1",
    "driver:sign-dev": "pwsh -NoProfile -File native/virtual-microphone/sign-development.ps1",
    "driver:probe": "data\\driver-development\\build\\ddtrans-probe.exe",
    "driver:package": "pwsh -NoProfile -File native/virtual-microphone/package-development.ps1"
  },
  "devDependencies": {
    "electron": "45.1.0"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
