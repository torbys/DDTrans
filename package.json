{
  "name": "ai-simultaneous-translation",
  "version": "2.1.0",
  "description": "Qwen 3.8 实时同传 · 说话人字幕与本地记录",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "serve": "node electron/service.js",
    "test": "node --test tests/*.test.cjs",
    "probe": "node scripts/probe-realtime.cjs",
    "verify:overlay": "electron scripts/verify-overlay.cjs",
    "verify:loopback": "electron scripts/verify-loopback.cjs",
    "verify:capture": "electron scripts/verify-capture.cjs",
    "verify:live": "electron scripts/verify-electron.cjs",
    "verify:audio-routing": "electron scripts/verify-audio-routing.cjs",
    "verify:desktop": "electron scripts/verify-desktop.cjs",
    "audio:prepare": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-virtual-audio.ps1",
    "audio:check": "data\\virtual-audio\\build\\ddtrans-audio-device.exe status",
    "audio:probe": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/probe-virtual-audio.ps1",
    "dist:win": "node scripts/package-windows.cjs",
    "pack:win": "node scripts/package-windows.cjs --dir",
    "verify:package": "node scripts/verify-windows-package.cjs",
    "verify:packaged-app": "node scripts/verify-packaged-app.cjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
